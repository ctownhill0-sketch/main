{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeadScout",
  "version": "0.1.0",
  "identifier": "com.leadscout.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LeadScout",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 16 }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "LeadScout",
    "copyright": "Copyright © 2026 LeadScout",
    "category": "Business",
    "shortDescription": "Desktop lead-generation on the Google Places API",
    "longDescription": "Discover, enrich, and manage local business leads from Google Maps data using the official Google Places API (New), with built-in cost guardrails and Google Maps Platform Terms compliance.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
