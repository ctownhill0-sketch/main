GOOGLE_PLACES_API_KEY=your_key_here

# Optional: show a one-time dismissible warning banner once your
# cumulative Places API request count crosses this number (and again
# each time it crosses another full multiple of it). Not a hard limit --
# just a nudge so usage can't silently run past a budget you meant to
# watch. Leave unset to disable.
# LEADZAP_REQUEST_WARN_AT=250
